# Copy this file to backend/.env and fill in the values

# Security - CHANGE THIS to a long random string in production
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-key-change-me

# JWT settings
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Local dev: SQLite (no setup needed)
DATABASE_URL=sqlite:///./task_manager.db
# Production (Render PostgreSQL): uncomment and fill in your Internal Database URL
# DATABASE_URL=postgresql://user:password@host/dbname

# App
DEBUG=False
